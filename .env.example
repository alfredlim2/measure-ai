# Measure.AI — server settings
# Copy this file to ".env" (same folder) and fill in your values. This file stays on the server: no value here
# is ever sent to the browser. ai-settings.json (same folder, optional) wins over the AI values below.

# ---- Website ----
# The address people open, without a trailing slash. Used for Google sign-in and password-reset links.
PUBLIC_URL=http://localhost:5173
PORT=5173
# 127.0.0.1 = this computer only. Behind a reverse proxy (HTTPS) keep 127.0.0.1; use 0.0.0.0 only to listen on all networks.
HOST=127.0.0.1
# Where the database (measure.db), uploaded drawings and saved runs are kept. Back this folder up.
DATA_DIR=./data

# ---- Accounts ----
# Emails that become administrators when they sign up (comma separated). The first account ever created is always one.
ADMIN_EMAILS=
# Free credits given to every new account.
SIGNUP_CREDITS=0
# Google sign-in (optional). Create an OAuth client ("Web application") in Google Cloud Console and add the
# redirect URI  <PUBLIC_URL>/auth/google/callback . Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password-reset emails through Resend (optional). Without a key the reset link is printed in the server console.
RESEND_API_KEY=
MAIL_FROM=Measure.AI <onboarding@resend.dev>

# ---- Credits and limits ----
# Credits charged per 1 USD of AI cost (a run is charged after it ends, rounded up).
CREDITS_PER_USD=100
# Largest PDF that can be uploaded, in MB.
MAX_UPLOAD_MB=150
# Measurements one account can run at the same time.
MAX_RUNS_PER_USER=2

# ---- AI service (server only) ----
OPENAI_API_KEY=
# Leave as is unless you use a compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Sheet naming: hard limit per sheet (ms) and how many sheets are named at the same time.
AI_SHEET_TIMEOUT_MS=30000
AI_CONCURRENCY=3
AI_IMAGE_DETAIL=high
# Optional cap per measurement, in milliseconds. Empty or 0 = no limit.
TAKEOFF_TIMEOUT_MS=
